[Unit]
Description=X Fresh Feed Tracker — Live API (localhost)
After=network.target

[Service]
Type=simple
User=curl
WorkingDirectory=/server/twitter-feed-extension
ExecStart=/usr/bin/python3 /server/twitter-feed-extension/api_server.py
Environment=PORT=8787
Environment=BIND=127.0.0.1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
